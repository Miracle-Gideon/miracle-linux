<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="Miracle Linux"
        android:theme="@style/Theme.MiracleLinux">
        <!--
          Native lib extraction (needed so libproot.so has a real executable
          file path) is now configured via packaging.jniLibs.useLegacyPackaging
          in build.gradle.kts, not this manifest attribute — AGP flags the
          manifest version as deprecated when both are set.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- This is what makes Miracle Linux replace the home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
